# Copy to .env and fill in real values. .env is gitignored and never committed.
# The demo runs fine WITHOUT any of these — AI coaching falls back to authored
# content when no key is present.

# OpenAI API — powers live coaching feedback and reflection prompts (U5).
# Leave OPENAI_API_KEY blank to force the authored fallback path.
OPENAI_API_KEY=
# Cost-efficient chat model. Confirm the current one before the demo.
OPENAI_MODEL=gpt-4o-mini

# Signed session cookie secret. Any long random string is fine for the demo.
SESSION_SECRET=change-me-to-a-long-random-string
